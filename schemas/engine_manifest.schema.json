{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engine Manifest",
  "description": "production/engine_manifest.json — engine allocation and render bookkeeping per scene.",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "project": { "type": "string" },
    "updated": { "type": "string" },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": { "type": "object",
                 "required": ["scene_id", "engine", "reason", "source_location",
                              "render_command", "output_path", "duration_sec",
                              "resolution", "fps", "status"],
                 "properties": {
                   "scene_id": { "type": "string", "pattern": "^SCENE-[0-9]{3}$" },
                   "engine": { "enum": ["hyperframes", "lemo-opuscar", "ffmpeg-assembly"] },
                   "reason": { "type": "string", "minLength": 1 },
                   "source_location": { "type": "string", "minLength": 1 },
                   "dependencies": { "type": "array", "items": { "type": "string" } },
                   "render_command": { "type": "string", "minLength": 1 },
                   "output_path": { "type": "string", "minLength": 1 },
                   "duration_sec": { "type": "number", "minimum": 0.1 },
                   "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
                   "fps": { "type": "number", "minimum": 12 },
                   "status": { "enum": ["PLANNED", "IN_PROGRESS", "RENDERED", "VERIFIED"] },
                   "rendered_at": { "type": "string" },
                   "verified_at": { "type": "string" },
                   "notes": { "type": "string" }
                 } }
    }
  }
}
