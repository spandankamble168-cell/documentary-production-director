{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Production Plan",
  "description": "Machine summary of production_plan.md (treatment).",
  "type": "object",
  "required": ["name", "premise", "central_question", "angle", "conflict",
               "chosen_structure", "target", "scene_outline"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "premise": { "type": "string" },
    "central_question": { "type": "string" },
    "angle": { "type": "string" },
    "conflict": { "type": "string" },
    "audience": { "type": "string" },
    "candidate_structures": {
      "type": "array", "minItems": 3,
      "items": { "type": "object",
                 "required": ["name", "summary"],
                 "properties": { "name": { "type": "string" },
                                 "summary": { "type": "string" } } }
    },
    "chosen_structure": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["duration_sec", "resolution", "fps", "language"],
      "properties": {
        "duration_sec": { "type": "integer", "minimum": 15 },
        "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "fps": { "type": "number", "minimum": 12 },
        "language": { "type": "string" },
        "speaking_rate_wpm": { "type": "number", "minimum": 60 }
      }
    },
    "tone": { "type": "string" },
    "visual_approach": { "type": "string" },
    "scene_outline": {
      "type": "array", "minItems": 1,
      "items": { "type": "object",
                 "required": ["act", "description"],
                 "properties": {
                   "act": { "type": "string" },
                   "description": { "type": "string" },
                   "approx_duration_sec": { "type": "number", "minimum": 0 }
                 } }
    },
    "defaults_chosen": { "type": "array", "items": { "type": "string" } }
  }
}
